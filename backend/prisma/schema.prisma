generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  COOP_ADMIN
  GOV_ADMIN
}

enum LangPref {
  EN
  HI
}

enum CoopStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  RELEASED
}

enum ProposalStatus {
  OPEN
  CLOSED
}

model User {
  id         String    @id @default(uuid())
  role       Role      @default(CUSTOMER)
  name       String
  phone      String    @unique
  lang_pref  LangPref  @default(EN)
  created_at DateTime  @default(now())

  // Relations
  workerProfile    Worker?
  coopAdminProfile Cooperative[] @relation("CoopAdmin")
  customerBookings Booking[]     @relation("CustomerBookings")

  @@map("users")
}

model Cooperative {
  id              String         @id @default(uuid())
  name            String
  registration_no String         @unique
  district        String
  state           String
  admin_user_id   String
  fund_balance    Decimal        @default(0.0) @db.Decimal(12, 2)
  status          CoopStatus     @default(PENDING)
  created_at      DateTime       @default(now())

  // Relations
  adminUser       User           @relation("CoopAdmin", fields: [admin_user_id], references: [id])
  workers         Worker[]
  categories      ServiceCategory[]
  proposals       Proposal[]

  @@map("cooperatives")
}

model Worker {
  id                  String             @id @default(uuid())
  user_id             String             @unique
  cooperative_id      String
  skills              String[]
  verification_status VerificationStatus @default(PENDING)
  rating_avg          Decimal            @default(0.0) @db.Decimal(3, 2)
  availability_status Boolean            @default(false)
  lat                 Float?
  lng                 Float?

  // Relations
  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cooperative         Cooperative        @relation(fields: [cooperative_id], references: [id], onDelete: Cascade)
  bookings            Booking[]
  votes               Vote[]

  @@map("workers")
}

model ServiceCategory {
  id             String       @id @default(uuid())
  name           String
  description    String
  base_rate      Decimal      @db.Decimal(10, 2)
  cooperative_id String?

  // Relations
  cooperative    Cooperative? @relation(fields: [cooperative_id], references: [id])
  bookings       Booking[]

  @@map("service_categories")
}

model Booking {
  id             String        @id @default(uuid())
  customer_id    String
  worker_id      String
  category_id    String
  status         BookingStatus @default(REQUESTED)
  scheduled_time DateTime
  address        String
  instructions   String?
  amount         Decimal       @db.Decimal(10, 2)
  created_at     DateTime      @default(now())

  // Relations
  customer       User          @relation("CustomerBookings", fields: [customer_id], references: [id])
  worker         Worker        @relation(fields: [worker_id], references: [id])
  category       ServiceCategory @relation(fields: [category_id], references: [id])
  payout         Payout?
  rating         Rating?

  @@map("bookings")
}

model Payout {
  id                String       @id @default(uuid())
  booking_id        String       @unique
  worker_share      Decimal      @db.Decimal(10, 2)
  cooperative_share Decimal      @db.Decimal(10, 2)
  platform_fee      Decimal      @db.Decimal(10, 2)
  status            PayoutStatus @default(PENDING)
  created_at        DateTime     @default(now())

  // Relations
  booking           Booking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("payouts")
}

model Rating {
  id         String   @id @default(uuid())
  booking_id String   @unique
  score      Int
  comment    String?
  created_at DateTime @default(now())

  // Relations
  booking    Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Proposal {
  id             String         @id @default(uuid())
  cooperative_id String
  title          String
  description    String
  options        String[]
  deadline       DateTime
  status         ProposalStatus @default(OPEN)
  created_at     DateTime       @default(now())

  // Relations
  cooperative    Cooperative    @relation(fields: [cooperative_id], references: [id], onDelete: Cascade)
  votes          Vote[]

  @@map("proposals")
}

model Vote {
  id          String   @id @default(uuid())
  proposal_id String
  worker_id   String
  choice      String
  created_at  DateTime @default(now())

  // Relations
  proposal    Proposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  worker      Worker   @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@unique([proposal_id, worker_id])
  @@map("votes")
}
